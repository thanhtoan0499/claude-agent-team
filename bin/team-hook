#!/usr/bin/env bash
# One hook for everything the log must capture without relying on the LLM remembering to call team-log.
#
# agent-team:* subagents
#   SubagentStart       -> agent_started (ref = subagent transcript)
#   SubagentStop        -> question (report has a NEEDS_DECISION line) | worker_done, body = FULL final report,
#                          + the model it really ran on and its usage (tokens in/cache/out, seconds, turns) from its transcript
#   PostToolUse         -> tool_call (one line: tool + key input)
#   PostToolUseFailure  -> error
# Every event goes to the feature of the session it came from (.team-log/sessions/<session id>, written when that session
#   opens the feature): two sessions running two tickets in one repo each log into their own ticket, subagents included.
# main thread (the master + the user), ONLY from a session bound to a feature touched < 12 h ago (no session id in the
#   payload: while .team-log/CURRENT is): another Claude Code session in the same repo is not the team, its prompts never
#   reach a ticket's log.
#   PostToolUse Bash `team-log feature_start ...` -> binds the session that ran it (re-run it to continue in a new session)
#   PostToolUse Bash `gh pr create ...`           -> pr (the PR URL) then feature_end: the ticket's log closes itself
#   UserPromptSubmit                   -> user_reply   (the user's prompt, verbatim)
#     + `/agent-team:team-lead <ADO work-item URL | AB#n>` with no feature tracking that ticket yet
#       -> feature_start --ticket n  (instant, deterministic: slug wi-n, or the existing feature of ticket n)
#       and a detached `team-ticket` that fetches type+title from Azure DevOps in the background (never blocks
#       the prompt). The master agent logs the same metadata itself (skill step 0): hook = fast + exact id,
#       agent = understands the ticket; the TUI shows whichever ticket_info arrives last.
#   SessionStart (startup|resume|clear|compact) and every 6th UserPromptSubmit -> prints the master's POLICY CARD
#     (skills/team-lead/references/policy-card.md) as additionalContext, so the decision policy survives a
#     compaction instead of living only in the first message of the session. ~150 tokens; only while a feature is active.
#   PreToolUse  Agent|Task|SendMessage -> task_assigned (the master's brief, verbatim)
#   PreToolUse  AskUserQuestion        -> escalation    (questions + options)
#   PostToolUse AskUserQuestion        -> user_reply    (the answers)
#   PostToolUseFailure Agent|Task|SendMessage|AskUserQuestion -> error
#
# The final report is NOT always last_assistant_message: an agent that ends through the SubagentHandback tool
# leaves that field empty, so the report is read from the subagent transcript (fallback chain below).
# Payload field names are read defensively (several candidates each) because the hook schemas are only partly
# documented; TEAM_HOOK_DEBUG=<file> appends every raw payload to that file so a missing event can be diagnosed.
# SubagentStop of the planner also saves its report as .team-log/<feature>/plan.md: the plan survives compaction on disk.
# Never blocks; prints only the policy-card JSON above; always exits 0.
trap 'exit 0' ERR
DIR=$(cd "$(dirname "$0")" && pwd)
. "$DIR/_lib.sh"
in=$(cat)
[ -n "${TEAM_HOOK_DEBUG:-}" ] && printf '%s\n' "$in" >> "$TEAM_HOOK_DEBUG"
# Cheap prefilter: this hook fires for EVERY prompt and tool call of the session. Skip the jq spawns unless the
# payload mentions something we log (precise checks follow).
case "$in" in
  *agent-team:*|*UserPromptSubmit*|*SessionStart*|*AskUserQuestion*|*SendMessage*|*'"Agent"'*|*'"Task"'*|*team-log*|*"gh pr create"*) ;;
  *) exit 0 ;;
esac
ev=$(jq -r '.hook_event_name // empty' <<<"$in")
agent=$(jq -r '.agent_type // "unknown"' <<<"$in")
id=$(jq -r '.agent_id // empty' <<<"$in")
cwd=$(jq -r '.cwd // empty' <<<"$in"); [ -n "$cwd" ] || cwd=$PWD
sid=$(jq -r '.session_id // empty' <<<"$in")
[ -n "$sid" ] && export TEAM_SESSION=$sid   # team_feature (here and in team-log) routes by it
# Main-thread events (the master and the user) carry the session and its folder, so team-tui can `claude --resume` the ticket.
log() {
  local who=(); [ -z "$id" ] && [ -n "$sid" ] && who=(--session "$sid" --cwd "$cwd")
  ( cd "$cwd" && "$DIR/team-log" "$@" ${who[@]+"${who[@]}"} ) 2>/dev/null || true
}
MAX=30000  # sanity cap on one logged body
J() { jq -r "$1" <<<"$in"; }  # extract with a jq filter from the payload

# Subagent transcript: explicit field if the host provides it, else <session>/subagents/agent-<id>.jsonl
# next to the session transcript (the layout Claude Code writes). Prints the path (existing or not).
agent_transcript() {
  local p t
  p=$(J '.agent_transcript_path // empty')
  if [ -z "$p" ]; then
    t=$(J '.transcript_path // empty')
    [ -n "$t" ] && [ -n "$id" ] && p="${t%.jsonl}/subagents/agent-$id.jsonl"
  fi
  [ -n "$p" ] && echo "$p"
}

# Last SubagentHandback message, else last assistant text block. Empty if none.
final_report() {
  jq -rs '[.[] | select(.type=="assistant") | .message.content[]?] as $b
    | ([$b[] | select(.type=="tool_use" and .name=="SubagentHandback") | .input.message] | last)
      // ([$b[] | select(.type=="text") | .text] | last) // empty' "$1" 2>/dev/null
}

# Compact one-line summary of a tool call's input.
summarize() {
  J '(.tool_input // {}) | (.command // .file_path // .path // .pattern // .query // .url // .description // tostring)
    | tostring | gsub("[\n\r\t]+";" ") | .[0:200]'
}

# Error text of a failed tool call, whichever field carries it.
err_text() {
  J '(.error // .tool_response.error // .error_message // .tool_response // "failed") | tostring | gsub("[\n\r\t]+";" ") | .[0:500]'
}

# Planner report -> <feature dir>/plan.md (latest wins). The master re-reads it after a compaction.
save_plan() {
  local f; f=$( cd "$cwd" && team_log_file ) || return 0
  { printf '<!-- planner report, %s -->\n' "$(date -u +%FT%TZ)"; printf '%s\n' "${1:0:$MAX}"; } > "$(dirname "$f")/plan.md" 2>/dev/null || true
}

team_agent_event() {
  local tool tp msg rep tries u m
  case "$ev" in
    SubagentStart)
      tp=$(agent_transcript || true)
      log agent_started --from "$agent" --agent-id "$id" --body "started" ${tp:+--ref "$tp"} ;;
    SubagentStop)
      msg=$(J '.last_assistant_message // empty')
      tries=${TEAM_HOOK_RETRIES:-4}
      while :; do
        tp=$(agent_transcript || true)
        rep=""; [ -n "$tp" ] && [ -f "$tp" ] && rep=$(final_report "$tp")
        [ -n "$rep" ] && { msg=$rep; break; }
        [ -n "$msg" ] && break                       # no transcript report, but the host gave us a message
        [ "$tries" -le 0 ] && break
        tries=$((tries - 1)); sleep 0.4              # transcript is written asynchronously: wait for the flush
      done
      # SubagentStop fires again when the hand-back is delivered to the master: same agent, same report -> log it once.
      if [ -n "$id" ] && [ -n "$msg" ]; then
        local lf sig; lf=$( cd "$cwd" && team_log_file ); lf="$(dirname "$lf")/.last_report_$id"
        sig=$(printf '%s' "$msg" | cksum | cut -d' ' -f1)
        [ "$(cat "$lf" 2>/dev/null)" = "$sig" ] && return 0
        echo "$sig" > "$lf" 2>/dev/null || true
      fi
      if [ "$agent" = agent-team:planner ] && [ -n "$msg" ]; then save_plan "$msg"; fi
      # What this run cost: model actually used + tokens + wall time, so a retro can weigh quality against cost per model.
      u=""; m=""; [ -n "$tp" ] && [ -f "$tp" ] && u=$(team_usage "$tp"); [ -n "$u" ] && { m=${u%% *}; u=${u#* }; }
      if grep -qE '^[[:space:]]*NEEDS_DECISION[[:space:]]*:?[[:space:]]*$' <<<"$msg"; then
        log question --from "$agent" --agent-id "$id" --body "${msg:0:$MAX}" ${tp:+--ref "$tp"} ${m:+--model "$m"} ${u:+--usage "$u"}
      else
        log worker_done --from "$agent" --agent-id "$id" --body "${msg:0:$MAX}" ${tp:+--ref "$tp"} ${m:+--model "$m"} ${u:+--usage "$u"}
      fi ;;
    PostToolUse)
      tool=$(J '.tool_name // "?"')
      [ "$tool" = SubagentHandback ] && return 0     # its payload is the final report, logged at SubagentStop
      log tool_call --from "$agent" --agent-id "$id" --body "$tool: $(summarize)" ;;
    PostToolUseFailure)
      tool=$(J '.tool_name // "?"')
      log error --from "$agent" --agent-id "$id" --body "$tool failed: $(err_text) | input: $(summarize)" ;;
  esac
}

# Is a feature being run right now, by THIS session? Its binding exists and was touched (by any logged event) within 12 h.
# No binding: only when no session at all is bound to CURRENT (a feature opened from a plain shell), CURRENT is fresh, the pre-0.1.17 rule.
fresh() { [ -s "$1" ] && [ -n "$(find "$1" -mmin -720 2>/dev/null)" ]; }
feature_active() {
  local cur b f; cur="$(team_root "$cwd")/.team-log/CURRENT"
  if [ -n "$sid" ]; then
    b=$(team_binding "$cwd")
    if [ -s "$b" ]; then fresh "$b"; return; fi
    [ "$(cat "$cur.session" 2>/dev/null)" = "$sid" ] && { fresh "$cur"; return; }   # pre-0.1.24 binding
    [ -s "$cur.session" ] && return 1
    f=$(head -1 "$cur" 2>/dev/null) || return 1
    grep -qxF -- "$f" "$(dirname "$cur")"/sessions/* 2>/dev/null && return 1
  fi
  fresh "$cur"
}

# This session runs <feature> from now on.
bind_session() { [ -n "$sid" ] && team_bind "$1" "$cwd"; return 0; }

# `/agent-team:team-lead ...<ticket>` -> open (or reuse) the feature for that ticket right away.
auto_start_feature() {
  local p=$1 tid url f
  grep -qE '^[[:space:]]*/(agent-team:)?team-lead([[:space:]]|$)' <<<"$p" || return 0
  tid=$(grep -oE '_workitems/edit/[0-9]+' <<<"$p" | head -1 | grep -oE '[0-9]+' || true)
  [ -n "$tid" ] || tid=$(grep -oE 'AB#[0-9]+' <<<"$p" | head -1 | grep -oE '[0-9]+' || true)
  [ -n "$tid" ] || return 0
  # Already tracked and active (e.g. continued in a new session): this session just takes it over.
  f=$(team_ticket_feature "$tid" "$cwd")
  if [ -n "$f" ] && fresh "$(team_root "$cwd")/.team-log/$f/events.ndjson"; then bind_session "$f"; return 0; fi
  log feature_start --ticket "$tid" --from user --body "${p:0:$MAX}"   # team-log binds this session (TEAM_SESSION)
  url=$(grep -oE 'https://dev\.azure\.com/[^[:space:]]*_workitems/edit/[0-9]+' <<<"$p" | head -1 || true)
  ( cd "$cwd" && nohup "$DIR/team-ticket" "$tid" ${url:+"$url"} >/dev/null 2>&1 </dev/null & ) 2>/dev/null || true
}

# Policy card as hook context. Dynamic bits: feature, plan path, counts of gates/escalations so far.
emit_card() {
  local card="$DIR/../skills/team-lead/references/policy-card.md" feat f plan stats esc
  [ -r "$card" ] || return 0
  feat=$( cd "$cwd" && team_feature ); f=$( cd "$cwd" && team_log_file ); plan="$(dirname "$f")/plan.md"
  [ -s "$plan" ] || plan="(not written yet: the planner's report becomes $plan)"
  esc=0; [ -s "$f" ] && esc=$(grep -c '"type":"escalation"' "$f" || true)
  stats="user asked $esc time(s) so far."
  card=$(<"$card"); card=${card//\{\{FEATURE\}\}/$feat}; card=${card//\{\{PLAN\}\}/$plan}; card=${card//\{\{STATS\}\}/$stats}
  jq -cn --arg ev "$ev" --arg c "$card" '{hookSpecificOutput:{hookEventName:$ev,additionalContext:$c}}'
}

# Every 6th user prompt of the active feature (1st, 7th, ...): counter lives next to the log, reset by SessionStart.
card_due() {
  local f cnt n; f=$( cd "$cwd" && team_log_file ); cnt="$(dirname "$f")/.card_n"
  n=$(cat "$cnt" 2>/dev/null || echo 0); n=$((n + 1)); echo "$n" > "$cnt" 2>/dev/null || true
  [ $(( (n - 1) % 6 )) -eq 0 ]
}

master_event() {
  local tool to desc body q b
  [ -z "$id" ] || return 0                           # subagent calls are handled above; this is the main thread
  if [ "$ev" = PostToolUse ] && [ "$(J '.tool_name // empty')" = Bash ] \
     && grep -qE '(^|[/[:space:];&|])team-log[[:space:]]+feature_start' <<<"$(J '.tool_input.command // empty')"; then
    # team-log bound this session itself when Claude Code gave it CLAUDE_CODE_SESSION_ID; otherwise bind it to what was just started
    b=$(team_binding "$cwd"); [ -n "$(find "$b" -mmin -1 2>/dev/null)" ] || bind_session "$(head -1 "$(team_root "$cwd")/.team-log/CURRENT" 2>/dev/null)"
    return 0
  fi
  if [ "$ev" = UserPromptSubmit ]; then
    body=$(J '.prompt // .user_prompt // empty')
    # Messages the harness injects into the user's turn (subagent hand-backs, task notifications) are not the user's words, and their
    # content is already logged as worker_done: never record them as user_reply, never count them for the card cadence.
    case "$body" in "<agent-message"*|"<task-notification"*|"<system-reminder"*|"[Subagent hand-back]"*) return 0;; esac
    [ -z "$body" ] || auto_start_feature "$body"
  fi
  feature_active || return 0
  if [ "$ev" = SessionStart ]; then
    { f=$( cd "$cwd" && team_log_file ); echo 0 > "$(dirname "$f")/.card_n"; } 2>/dev/null || true
    emit_card; return 0
  fi
  tool=$(J '.tool_name // empty')
  case "$ev:$tool" in
    UserPromptSubmit:*)
      body=$(J '.prompt // .user_prompt // empty')
      [ -n "$body" ] && log user_reply --from user --to master --body "${body:0:$MAX}"
      card_due && emit_card ;;
    PreToolUse:Agent|PreToolUse:Task)
      to=$(J '.tool_input.subagent_type // "general-purpose"')
      desc=$(J '.tool_input.description // empty')
      body=$(J '.tool_input.prompt // empty')
      # Model the agent will run on: the master's per-dispatch override, else the agent file's `model:`, else inherited.
      model=$(J '.tool_input.model // empty')
      if [ -z "$model" ]; then
        case "$to" in agent-team:*) model=$(sed -n '2,/^---$/s/^model: *//p' "$DIR/../agents/${to#agent-team:}.md" 2>/dev/null | head -1);; esac
      fi
      [ -n "$body" ] && log task_assigned --from master --to "$to" --task "$desc" --model "${model:-inherit}" --body "${body:0:$MAX}" ;;
    PreToolUse:SendMessage)
      to=$(J '.tool_input.to // empty')
      body=$(J '(.tool_input.message // empty) | if type=="string" then . else tojson end')
      [ -n "$to" ] && [ -n "$body" ] && log task_assigned --from master --to "$to" --body "${body:0:$MAX}" ;;
    PreToolUse:AskUserQuestion)
      body=$(J '[.tool_input.questions[]? | "Q" + (if .header then " [" + .header + "]" else "" end) + ": " + .question
        + ((.options // []) | map("\n  - " + .label + (if .description then " - " + .description else "" end)) | join(""))] | join("\n\n")')
      q=$(J '[.tool_input.questions[]?.options[]?.label] | join("|")')
      [ -n "$body" ] && log escalation --from master --to user --body "${body:0:$MAX}" ${q:+--options "$q"} ;;
    PostToolUse:AskUserQuestion)
      body=$(J '(.tool_response.answers // .tool_response // empty) | if type=="string" then . else tojson end')
      [ -n "$body" ] && log user_reply --from user --to master --body "${body:0:$MAX}" ;;
    PostToolUse:Bash)
      # A PR opened by the master closes the ticket's log: the URL is what team-outcome follows later.
      grep -qE '(^|[;&|[:space:]])gh[[:space:]]+pr[[:space:]]+create' <<<"$(J '.tool_input.command // empty')" || return 0
      body=$(J '.tool_response | if type=="string" then . else tojson end' | grep -oE 'https://github\.com/[^[:space:]"\\]+/pull/[0-9]+' | tail -1 || true)
      [ -n "$body" ] || return 0
      to=$( cd "$cwd" && team_feature )
      log pr --from master --feature "$to" --body "$body"
      log feature_end --from master --feature "$to" --body "PR opened: $body" ;;
    PostToolUseFailure:AskUserQuestion|PostToolUseFailure:Agent|PostToolUseFailure:Task|PostToolUseFailure:SendMessage)
      log error --from master --body "$tool failed: $(err_text)" ;;
  esac
}

case "$agent" in
  agent-team:*) team_agent_event ;;
  *) master_event ;;
esac
exit 0
