#!/usr/bin/env bash
# Human-readable timeline. usage: team-report [feature]   (default: current feature)
set -euo pipefail
. "$(dirname "$0")/_lib.sh"
[ -n "${1:-}" ] && export TEAM_FEATURE=$1
f=$(team_log_file); [ -s "$f" ] || { echo "no events: $f" >&2; exit 1; }
jq -r '
  "\(.ts[11:19]) [\(.type)] " +
  (if .from and .to then "\(.from) -> \(.to)" elif .from then .from elif .to then "-> \(.to)" else "" end) +
  (if .task then " (\(.task))" else "" end) +
  (if .body then "\n    \(.body | gsub("\n";" ") | .[0:300])" else "" end) +
  (if .options then "\n    options: \(.options|join(" | "))" else "" end) +
  (if .rationale then "\n    WHY: \(.rationale)" else "" end)' "$f"
echo "--- $(wc -l < "$f") events | questions: $(jq -s 'map(select(.type=="question"))|length' "$f") | decisions: $(jq -s 'map(select(.type=="decision"))|length' "$f")"
