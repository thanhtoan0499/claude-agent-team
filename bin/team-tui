#!/usr/bin/env python3
"""lazygit-style browser for the team log. Left: features/tickets. Enter: timeline of that feature.
NDJSON stays the source of truth; <log dir>/team.db (SQLite) is a derived index synced on every refresh.
usage: team-tui            interactive (j/k move, enter open, f Q&A-only, G follow end, esc back, q quit)
       team-tui --dump [feature]   plain text, no curses (scripts/tests)"""
import curses, glob, json, os, re, sqlite3, subprocess, sys, textwrap
from datetime import datetime, timezone

def log_dir():
    if os.environ.get("TEAM_LOG_DIR"): return os.environ["TEAM_LOG_DIR"]
    try:
        c = subprocess.check_output(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                                    stderr=subprocess.DEVNULL, text=True).strip()
        return os.path.join(os.path.dirname(c), ".team-log")
    except Exception:
        return os.path.join(os.getcwd(), ".team-log")

def open_db(d):
    os.makedirs(d, exist_ok=True)
    con = sqlite3.connect(os.path.join(d, "team.db")); con.row_factory = sqlite3.Row
    cols = [r[1] for r in con.execute("pragma table_info(events)")]
    if cols and "ticket" not in cols: con.execute("drop table events")  # derived index: rebuilt from the NDJSON
    con.execute("""create table if not exists events(feature text, line int, ts text, type text, frm text, dst text,
        task text, body text, rationale text, options text, agent_id text, ticket text, ttype text, title text,
        primary key(feature, line))""")
    return con

def sync(con, d):  # append-only logs: ingest only lines beyond what the DB already has
    for f in glob.glob(os.path.join(d, "*", "events.ndjson")):
        feat = os.path.basename(os.path.dirname(f))
        done = con.execute("select coalesce(max(line),0) from events where feature=?", (feat,)).fetchone()[0]
        with open(f, encoding="utf-8") as fh:
            for n, raw in enumerate(fh, 1):
                if n <= done: continue
                try: e = json.loads(raw)
                except ValueError: continue  # torn/garbled line: skip, keep numbering
                con.execute("insert or ignore into events values(?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                    (feat, n, e.get("ts"), e.get("type"), e.get("from"), e.get("to"), e.get("task"), e.get("body"),
                     e.get("rationale"), " | ".join(e.get("options", [])), e.get("agent_id"),
                     e.get("ticket"), e.get("ticket_type"), e.get("title")))
    con.commit()

def features(con):
    return con.execute("""select feature, min(ts) first, max(ts) last, count(*) n,
        sum(type='question') q, sum(type='decision') d, sum(type='review_finding') r,
        sum(type='agent_started') st, sum(type in ('worker_done','question') and agent_id is not null and agent_id!='') en,
        (select body from events x where x.feature=e.feature and type='feature_start' limit 1) request,
        (select ticket from events x where x.feature=e.feature and x.ticket is not null and x.ticket!='' order by line desc limit 1) ticket,
        (select ttype from events x where x.feature=e.feature and x.ttype is not null and x.ttype!='' order by line desc limit 1) ttype,
        (select title from events x where x.feature=e.feature and x.title is not null and x.title!='' order by line desc limit 1) title
        from events e group by feature order by last desc""").fetchall()

def status(f): return "running" if f["st"] > f["en"] else "idle"

def ts(s): return datetime.strptime(s.split(".")[0].rstrip("Z"), "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc)  # ms optional
def mmss(sec): return f"{int(sec)//60:02d}:{int(sec)%60:02d}"

ICON = {"feature_start": "▶", "task_assigned": "→", "question": "?", "decision": "✔", "agent_started": "·",
        "worker_done": "■", "review_finding": "!", "stack_provisioned": "◆", "note": "·",
        "escalation": "⇧", "user_reply": "↩", "error": "✖", "tool_call": "·", "feature_end": "■", "ticket_info": "#"}
COLOR = {"question": 3, "decision": 2, "review_finding": 1, "task_assigned": 6, "worker_done": 4, "feature_start": 5,
         "escalation": 3, "user_reply": 5, "error": 1}
QA = {"question", "decision", "review_finding", "escalation", "user_reply", "error"}

def timeline(con, feat, width, qa_only=False):
    """-> [(text, color)] ; durations pair agent_started/stop by agent_id."""
    rows = con.execute("select * from events where feature=? order by line", (feat,)).fetchall()
    if not rows: return []
    t0 = ts(rows[0]["ts"]); starts = {}; out = []; w = max(width - 6, 20)
    for r in rows:
        t = ts(r["ts"]); dur = ""
        aid = r["agent_id"]
        if r["type"] == "agent_started" and aid: starts[aid] = t
        elif aid and aid in starts and r["type"] in ("worker_done", "question"):
            dur = f" ({mmss((t - starts[aid]).total_seconds())})"
        if qa_only and r["type"] not in QA: continue
        who = r["frm"] or ""
        if r["type"] == "tool_call":  # one compact line each; hidden by the Q&A filter
            out.append((f"+{mmss((t - t0).total_seconds())} · {who}: {(r['body'] or '')[:w]}", 0)); continue
        if r["dst"]: who = f"{who}→{r['dst']}" if who else f"→{r['dst']}"
        head = f"+{mmss((t - t0).total_seconds())} {ICON.get(r['type'], '·')} {r['type']} {who}" + \
               (f" [{r['task']}]" if r["task"] else "") + dur
        c = COLOR.get(r["type"], 0)
        out.append((head, c))
        if r["type"] == "agent_started": continue
        for para in (r["body"] or "").splitlines() or [""]:
            for ln in textwrap.wrap(para, w) or ([""] if r["body"] else []): out.append(("    " + ln, 0))
        if r["options"]: out.append(("    options: " + r["options"], 0))
        if r["rationale"]:
            for i, ln in enumerate(textwrap.wrap(r["rationale"], w - 5)): out.append(("    " + ("WHY: " if not i else "     ") + ln, 2))
    return out

def local(s): return ts(s).astimezone().strftime("%m-%d %H:%M")

def ticket_label(f):
    """Ticket number FIRST: '[bug-8991] title'. Metadata (ticket_info / feature_start --ticket) wins; otherwise the
    number is read from the slug: type-8991-name, 8991-name or name-8991 (older logs). No number -> the slug."""
    slug = f["feature"]; tid = f["ticket"] or ""; tt = f["ttype"] or ""; name = f["title"] or ""
    m = re.match(r"^(?:([a-z]+)-)?(\d{3,})(?:-(.*))?$", slug)
    if m: s_tt, s_id, s_name = m.group(1) or "", m.group(2), (m.group(3) or "").replace("-", " ")
    else:
        m = re.search(r"^(.*?)-?(\d{3,})$", slug)
        s_tt, s_id, s_name = ("", m.group(2), m.group(1).replace("-", " ")) if m else ("", "", "")
    tid = tid or s_id; tt = tt or s_tt; name = name or s_name
    if not tid: return slug
    if tt == "wi": tt = ""  # 'wi' = work item of unknown type: show the bare number
    return f"[{tt + '-' if tt else ''}{tid}] {name}".rstrip()

def feature_line(f, w):
    lab = ticket_label(f); mark = "●" if status(f) == "running" else " "
    if w < 72: return f"{mark} {lab}"  # split view: the ticket is all that fits
    stats = f"{local(f['first'])}  ev:{f['n']:<3} ?:{f['q']:<2} ✔:{f['d']:<2} !:{f['r']}"
    return f"{mark} {lab:<{w - len(stats) - 4}.{w - len(stats) - 4}}  {stats}"

def dump(con, feat):
    if feat: print("\n".join(t for t, _ in timeline(con, feat, 100))); return
    for f in features(con): print(feature_line(f, 110))

SCROLL_KEYS = {ord(c) for c in "jkbgG "} | {curses.KEY_DOWN, curses.KEY_UP, curses.KEY_NPAGE, curses.KEY_PPAGE}

def scroll(k, top, follow, maxtop, page):
    """In-ticket scrolling. -> (top, follow). follow = pinned to newest line."""
    if k in (ord("j"), curses.KEY_DOWN): top += 1
    elif k in (ord("k"), curses.KEY_UP): top -= 1
    elif k in (curses.KEY_NPAGE, ord(" ")): top += page
    elif k in (curses.KEY_PPAGE, ord("b")): top -= page
    elif k == ord("g"): top = 0
    elif k == ord("G"): top = maxtop
    else: return top, follow
    top = max(0, min(top, maxtop))
    return top, top >= maxtop

def copy_clip(text):
    """wl-copy / xclip if present, else OSC52 (works over ssh/tmux in most terminals). -> label of what was used."""
    import base64, shutil
    for name, cmd in (("wl-copy", ["wl-copy"]), ("xclip", ["xclip", "-selection", "clipboard"])):
        if shutil.which(name) and (name == "xclip" and os.environ.get("DISPLAY") or name == "wl-copy" and os.environ.get("WAYLAND_DISPLAY")):
            try:
                subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True).communicate(text.encode(), timeout=3)
                return name
            except Exception: pass
    sys.stdout.write("\033]52;c;" + base64.b64encode(text.encode()).decode() + "\a"); sys.stdout.flush()
    return "OSC52"

def ui(scr, con, d):
    curses.curs_set(0); curses.use_default_colors()
    for i in range(1, 7): curses.init_pair(i, i, -1)
    curses.init_pair(7, curses.COLOR_BLACK, curses.COLOR_CYAN)
    scr.timeout(2000)
    feat = None; sel = 0; top = 0; qa = False; follow = True; lw = 0; msg = ""; maxtop = 0
    while True:
        sync(con, d); fs = features(con); h, w = scr.getmaxyx(); scr.erase()
        if not fs: scr.addstr(0, 0, f"no events in {d}   (q quit)"); k = scr.getch()
        else:
            sel = max(0, min(sel, len(fs) - 1)); lw = min(max(48, w // 3), w - 20) if feat else w
            scr.addstr(0, 0, " Tickets / features ".ljust(lw)[:lw], curses.color_pair(7))
            for i, f in enumerate(fs[: h - 2]):
                attr = curses.A_REVERSE if i == sel else (curses.color_pair(2) if status(f) == "running" else 0)
                scr.addstr(i + 1, 0, feature_line(f, lw).ljust(lw)[: lw - 1], attr)
            if feat:
                cur = fs[sel]["feature"]; body_w = w - lw - 2
                lines = timeline(con, cur, body_w, qa)
                view = h - 2; maxtop = max(0, len(lines) - view)
                top = maxtop if follow else max(0, min(top, maxtop))
                scr.addstr(0, lw + 1, f" {ticket_label(fs[sel])}{'  [Q&A only]' if qa else ''} ".ljust(body_w)[:body_w], curses.color_pair(7))
                for i, (t, c) in enumerate(lines[top: top + view]):
                    scr.addstr(i + 1, lw + 1, t[:body_w], curses.color_pair(c) if c else 0)
            else:
                f = fs[sel]
                scr.addstr(h - 2, 0, (f["request"] or "").replace("\n", " ")[: w - 1], curses.A_DIM)
            keys = (" j/k scroll  space/b page  g/G top/end  n/p ticket  c copy  f Q&A  esc back  q quit "
                    if feat else " j/k move  enter open  c copy  q quit ")
            scr.addstr(h - 1, 0, (keys + (f"| {top + 1}/{len(lines)} " if feat else "") + (f"| {msg}" if msg else ""))[: w - 1], curses.A_DIM)
            k = scr.getch()
        if k in (ord("q"),) or (k == 27 and not feat): return
        msg = ""
        if k == 27 and feat: feat = None
        elif k == ord("c") and fs:
            txt = "\n".join(t for t, _ in timeline(con, fs[sel]["feature"], 10**6, qa if feat else False))
            msg = f"copied {txt.count(chr(10)) + 1} lines via {copy_clip(txt)}"
        elif feat and k in SCROLL_KEYS: top, follow = scroll(k, follow and maxtop or top, follow, maxtop, h - 3)
        elif feat and k in (ord("n"), ord("p")): sel += 1 if k == ord("n") else -1; top = 0; follow = True
        elif k in (ord("j"), curses.KEY_DOWN): sel += 1
        elif k in (ord("k"), curses.KEY_UP): sel -= 1
        elif k in (10, 13, curses.KEY_ENTER, curses.KEY_RIGHT, ord("l")): feat = True; follow = True
        elif k == curses.KEY_LEFT or k == ord("h"): feat = None
        elif k == ord("f"): qa = not qa

if __name__ == "__main__":
    d = log_dir(); con = open_db(d); sync(con, d)
    if len(sys.argv) > 1 and sys.argv[1] == "--dump": dump(con, sys.argv[2] if len(sys.argv) > 2 else None)
    else: curses.wrapper(ui, con, d)
