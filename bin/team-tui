#!/usr/bin/env python3
"""lazygit-style browser for the team log of EVERY repo. Left: tickets (all repos, newest first). Enter: timeline.
Each repo's <repo>/.team-log/<ticket>/events.ndjson stays the source of truth (the hooks only ever append there).
~/.claude/agent-team/team.db (SQLite; TEAM_HOME overrides the folder) is a derived index over all of them: repos are listed
in ~/.claude/agent-team/repos by team-log, and the repo you run team-tui in is added automatically. Delete team.db any time:
it is rebuilt from the NDJSON files (rows of a repo that was deleted from disk survive in it until you delete it).
usage: team-tui            interactive (j/k move, g/G first/last, enter open, o expand, f Q&A-only, esc back, q quit)
       team-tui --dump [ticket|repo/ticket]   plain text, no curses (scripts/tests)
       team-tui --add PATH     register a repo (its .team-log) or a .team-log folder
       team-tui --query SQL    read-only SQL over the index (table events), tab-separated; used by team-retro
TEAM_LOG_DIR=<dir> restricts everything to that one log folder (own team.db inside it): old per-repo behaviour.
Cost model: a keypress never rebuilds the timeline. Lines are built once per (ticket, width, filter), extended only by
events appended since, and a body longer than BODY_PREVIEW lines is wrapped lazily: only its head, until you press o."""
import os
os.environ.setdefault("ESCDELAY", "25")  # curses waits this long after Esc for an escape sequence (default 1000 ms = a laggy 'back')
import curses, glob, json, re, sqlite3, subprocess, sys, textwrap
from datetime import datetime, timezone

def team_home(): return os.environ.get("TEAM_HOME") or os.path.expanduser("~/.claude/agent-team")

def repo_log_dir():
    """The .team-log of the repo we are in (worktrees share the main repo's)."""
    try:
        c = subprocess.check_output(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                                    stderr=subprocess.DEVNULL, text=True).strip()
        return os.path.join(os.path.dirname(c), ".team-log")
    except Exception:
        return os.path.join(os.getcwd(), ".team-log")

def registry():
    try:
        with open(os.path.join(team_home(), "repos"), encoding="utf-8") as fh:
            return list(dict.fromkeys(l.strip() for l in fh if l.strip()))
    except OSError:
        return []

def register(path):
    path = os.path.abspath(path)
    if os.path.basename(path) != ".team-log": path = os.path.join(path, ".team-log")
    if path in registry(): return path
    os.makedirs(team_home(), exist_ok=True)
    with open(os.path.join(team_home(), "repos"), "a", encoding="utf-8") as fh: fh.write(path + "\n")
    return path

def make_sources():
    """-> callable returning the log folders to index. Re-reads the registry each call, so a repo that starts logging
    while the TUI is open shows up on the next tick."""
    if os.environ.get("TEAM_LOG_DIR"):
        only = [os.environ["TEAM_LOG_DIR"]]; return lambda: only
    here = repo_log_dir(); added = []
    def sources():
        if not added and os.path.isdir(here): register(here)
        added.append(1)
        return registry()
    return sources

def db_path():
    return os.path.join(os.environ["TEAM_LOG_DIR"] if os.environ.get("TEAM_LOG_DIR") else team_home(), "team.db")

def open_db(path):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    con = sqlite3.connect(path); con.row_factory = sqlite3.Row
    cols = [r[1] for r in con.execute("pragma table_info(events)")]
    if cols and "turns" not in cols: con.execute("drop table events")  # derived index: rebuilt from the NDJSON
    con.execute("""create table if not exists events(src text, repo text, feature text, line int, ts text, type text,
        frm text, dst text, task text, body text, rationale text, options text, agent_id text, ticket text, ttype text,
        title text, decided_by text, verdict text, codes text, plugin_version text, model text,
        tokens_in int, tokens_cache int, tokens_out int, secs int, turns int,
        primary key(src, feature, line))""")
    con.execute("create index if not exists ev_type on events(type)")
    return con

_seen = {}  # log path -> (lines consumed, byte offset): where this process stopped reading each append-only log

def _skip(f, n):
    """-> (lines, offset) after the first n complete lines of f; fewer lines than n means the log is not the one the DB indexed."""
    c = off = 0
    with open(f, "rb") as fh:
        for raw in fh:
            if c == n or not raw.endswith(b"\n"): break
            c += 1; off += len(raw)
    return c, off

def repo_name(src): return os.path.basename(os.path.dirname(os.path.abspath(src).rstrip("/"))) or src

def sync(con, srcs):
    """Ingest events appended since the last call to every log folder in srcs, reading only the new bytes (a keypress
    must not re-read the whole log). -> number of new events."""
    new = 0
    for src in srcs:
        repo = repo_name(src)
        for f in glob.glob(os.path.join(src, "*", "events.ndjson")):
            feat = os.path.basename(os.path.dirname(f))
            try: size = os.path.getsize(f)
            except OSError: continue
            if f not in _seen:  # first look in this process: resume after what the DB already holds
                done = con.execute("select coalesce(max(line),0) from events where src=? and feature=?", (src, feat)).fetchone()[0]
                c, off = _skip(f, done)
                if c < done: con.execute("delete from events where src=? and feature=?", (src, feat)); c = off = 0  # log replaced: reindex
                _seen[f] = (c, off)
            n, off = _seen[f]
            if size < off: con.execute("delete from events where src=? and feature=?", (src, feat)); n = off = 0  # log truncated: reindex
            if size == off: _seen[f] = (n, off); continue
            with open(f, "rb") as fh:
                fh.seek(off)
                for raw in fh:
                    whole = raw.endswith(b"\n")
                    try: e = json.loads(raw)
                    except ValueError:
                        if not whole: break  # half-written tail: pick it up once the writer finishes it
                        n += 1; off += len(raw); continue  # garbled line: skip, keep numbering
                    new += con.execute("insert or ignore into events values(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                        (src, repo, feat, n + 1, e.get("ts"), e.get("type"), e.get("from"), e.get("to"), e.get("task"), e.get("body"),
                         e.get("rationale"), " | ".join(e.get("options", [])), e.get("agent_id"),
                         e.get("ticket"), e.get("ticket_type"), e.get("title"),
                         e.get("decided_by"), e.get("verdict"), e.get("codes"), e.get("plugin_version"), e.get("model"),
                         e.get("tokens_in"), e.get("tokens_cache"), e.get("tokens_out"), e.get("secs"), e.get("turns"))).rowcount
                    if not whole: break  # complete JSON but no newline yet: keep it, re-read (and ignore the duplicate) later
                    n += 1; off += len(raw)
            _seen[f] = (n, off)
    con.commit()
    return new

def features(con):
    """One row per ticket per repo, newest first. fid(row) = (src, feature) identifies it."""
    return con.execute("""select src, repo, feature, min(ts) first, max(ts) last, count(*) n,
        sum(type='question') q, sum(type='decision') d, sum(type='review_finding') r,
        sum(type='agent_started') st, sum(type in ('worker_done','question') and agent_id is not null and agent_id!='') en,
        (select body from events x where x.src=e.src and x.feature=e.feature and type='feature_start' limit 1) request,
        (select ticket from events x where x.src=e.src and x.feature=e.feature and x.ticket is not null and x.ticket!='' order by line desc limit 1) ticket,
        (select ttype from events x where x.src=e.src and x.feature=e.feature and x.ttype is not null and x.ttype!='' order by line desc limit 1) ttype,
        (select title from events x where x.src=e.src and x.feature=e.feature and x.title is not null and x.title!='' order by line desc limit 1) title
        from events e group by src, feature order by last desc""").fetchall()

def fid(f): return (f["src"], f["feature"])

def status(f): return "running" if f["st"] > f["en"] else "idle"

def ts(s): return datetime.strptime(s.split(".")[0].rstrip("Z"), "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc)  # ms optional
def mmss(sec): return f"{int(sec)//60:02d}:{int(sec)%60:02d}"

ICON = {"feature_start": "▶", "task_assigned": "→", "question": "?", "decision": "✔", "agent_started": "·",
        "worker_done": "■", "review_finding": "!", "stack_provisioned": "◆", "note": "·",
        "escalation": "⇧", "user_reply": "↩", "error": "✖", "tool_call": "·", "feature_end": "■", "ticket_info": "#", "gate": "⚖", "baseline": "◇",
        "pr": "⇪", "outcome": "◎"}
COLOR = {"question": 3, "decision": 2, "review_finding": 1, "task_assigned": 6, "worker_done": 4, "feature_start": 5,
         "escalation": 3, "user_reply": 5, "error": 1, "gate": 3, "baseline": 3, "pr": 2, "outcome": 2}
QA = {"question", "decision", "review_finding", "escalation", "user_reply", "error", "gate", "baseline", "pr", "outcome"}

BODY_PREVIEW = 20  # wrapped lines of one body shown before it collapses to "… +N more lines" (o expands, O expands all)

def wrap_body(body, w, limit=None):
    """Wrapped lines of a body, stopping once `limit` lines are out (None = all): text past the limit is never wrapped.
    -> (lines, source lines left unshown)"""
    paras = (body or "").splitlines() or [""]; out = []
    for i, para in enumerate(paras):
        if limit is not None and len(out) >= limit: return out, len(paras) - i
        cap = None if limit is None else (limit - len(out)) * w * 2
        cut = cap is not None and len(para) > cap  # one enormous line (a JSON blob): wrap only its head
        out += textwrap.wrap(para[:cap] if cut else para, w) or ([""] if body else [])
        if cut: return out[:limit], len(paras) - i
    return out, 0

class Timeline:
    """[(text, color)] for ONE ticket (fid = (src, feature)) at one width/filter, built incrementally: update() folds in only the events appended
    since the last call, so scrolling never re-wraps anything. Durations pair agent_started/stop by agent_id.
    marks = [(index into lines, event line)] of the collapsed bodies; `expanded` = event lines shown in full."""
    def __init__(s, feat, width, qa_only=False, expanded=(), everything=False):
        s.feat, s.w, s.qa = feat, max(width - 6, 20), qa_only
        s.expanded, s.everything = frozenset(expanded), everything
        s.last = 0; s.t0 = None; s.starts = {}; s.lines = []; s.marks = []

    def update(s, con):
        rows = con.execute("select * from events where src=? and feature=? and line>? order by line", (*s.feat, s.last)).fetchall()
        for r in rows: s._add(r)
        if rows: s.last = rows[-1]["line"]
        return s.lines

    def _add(s, r):
        out = s.lines; w = s.w; t = ts(r["ts"]); dur = ""; aid = r["agent_id"]
        if s.t0 is None: s.t0 = t
        if r["type"] == "agent_started" and aid: s.starts[aid] = t
        elif aid and aid in s.starts and r["type"] in ("worker_done", "question"):
            dur = f" ({mmss((t - s.starts[aid]).total_seconds())})"
        if s.qa and r["type"] not in QA: return
        who = r["frm"] or ""
        if r["type"] == "tool_call":  # one compact line each; hidden by the Q&A filter
            out.append((f"+{mmss((t - s.t0).total_seconds())} · {who}: {(r['body'] or '')[:w]}", 0)); return
        if r["dst"]: who = f"{who}→{r['dst']}" if who else f"→{r['dst']}"
        head = f"+{mmss((t - s.t0).total_seconds())} {ICON.get(r['type'], '·')} {r['type']} {who}" + \
               (f" [{r['task']}]" if r["task"] else "") + dur + \
               (f" [by {r['decided_by']}]" if r["decided_by"] else "") + \
               (f" {r['verdict']}" + (f" ({r['codes']})" if r["codes"] else "") if r["verdict"] else "") + \
               (f" · {r['model']}" if r["model"] else "") + \
               (f" · {(r['tokens_in'] or 0) + (r['tokens_cache'] or 0) + (r['tokens_out'] or 0):,} tok" if r["turns"] else "")
        out.append((head, COLOR.get(r["type"], 0)))
        if r["type"] == "agent_started": return
        full = s.everything or r["line"] in s.expanded
        body, hidden = wrap_body(r["body"], w, None if full else BODY_PREVIEW)
        out.extend(("    " + ln, 0) for ln in body)
        if hidden:
            s.marks.append((len(out), r["line"])); out.append((f"    … +{hidden} more lines  (o: expand)", 4))
        if r["options"]: out.append(("    options: " + r["options"], 0))
        if r["rationale"]:
            for i, ln in enumerate(textwrap.wrap(r["rationale"], w - 5)): out.append(("    " + ("WHY: " if not i else "     ") + ln, 2))

def timeline(con, feat, width, qa_only=False, full=True):
    """-> [(text, color)]. One-shot (dump, copy): every body in full unless full=False."""
    return Timeline(feat, width, qa_only, everything=full).update(con)

def local(s): return ts(s).astimezone().strftime("%m-%d %H:%M")

def ticket_label(f):
    """Ticket number FIRST: '[bug-8991] title'. Metadata (ticket_info / feature_start --ticket) wins; otherwise the
    number is read from the slug: type-8991-name, 8991-name or name-8991 (older logs). No number -> the slug."""
    slug = f["feature"]; tid = f["ticket"] or ""; tt = f["ttype"] or ""; name = f["title"] or ""
    m = re.match(r"^(?:([a-z]+)-)?(\d{3,})(?:-(.*))?$", slug)
    if m: s_tt, s_id, s_name = m.group(1) or "", m.group(2), (m.group(3) or "").replace("-", " ")
    else:
        m = re.search(r"^(.*?)-?(\d{3,})$", slug)
        s_tt, s_id, s_name = ("", m.group(2), m.group(1).replace("-", " ")) if m else ("", "", "")
    tid = tid or s_id; tt = tt or s_tt; name = name or s_name
    if not tid: return slug
    if tt == "wi": tt = ""  # 'wi' = work item of unknown type: show the bare number
    return f"[{tt + '-' if tt else ''}{tid}] {name}".rstrip()

def feature_line(f, w):
    lab = ticket_label(f); mark = "●" if status(f) == "running" else " "; repo = f["repo"] or ""
    if w < 72:  # split view: the ticket first, the repo on what is left
        room = w - len(repo) - 4
        return f"{mark} {lab:<{room}.{room}} {repo}" if room >= 24 else f"{mark} {lab}"
    stats = f"{repo:<14.14} {local(f['first'])}  ev:{f['n']:<3} ?:{f['q']:<2} ✔:{f['d']:<2} !:{f['r']}"
    return f"{mark} {lab:<{w - len(stats) - 4}.{w - len(stats) - 4}}  {stats}"

def dump(con, arg):
    """No arg: the ticket list. 'ticket' or 'repo/ticket': that timeline (every match, headed when several)."""
    fs = features(con)
    if not arg:
        for f in fs: print(feature_line(f, 110))
        return
    hit = [f for f in fs if arg in (f["feature"], f"{f['repo']}/{f['feature']}")]
    if not hit: sys.exit(f"team-tui: no ticket {arg!r} (try: team-tui --dump)")
    for f in hit:
        if len(hit) > 1: print(f"== {f['repo']}/{f['feature']} ==")
        print("\n".join(t for t, _ in timeline(con, fid(f), 100)))

SCROLL_KEYS = {ord(c) for c in "jkbgG "} | {curses.KEY_DOWN, curses.KEY_UP, curses.KEY_NPAGE, curses.KEY_PPAGE, curses.KEY_HOME, curses.KEY_END}

def scroll(k, top, follow, maxtop, page):
    """In-ticket scrolling. -> (top, follow). follow = pinned to newest line."""
    if k in (ord("j"), curses.KEY_DOWN): top += 1
    elif k in (ord("k"), curses.KEY_UP): top -= 1
    elif k in (curses.KEY_NPAGE, ord(" ")): top += page
    elif k in (curses.KEY_PPAGE, ord("b")): top -= page
    elif k in (ord("g"), curses.KEY_HOME): top = 0
    elif k in (ord("G"), curses.KEY_END): top = maxtop
    else: return top, follow
    top = max(0, min(top, maxtop))
    return top, top >= maxtop

def copy_clip(text):
    """wl-copy / xclip if present, else OSC52 (works over ssh/tmux in most terminals). -> label of what was used."""
    import base64, shutil
    for name, cmd in (("wl-copy", ["wl-copy"]), ("xclip", ["xclip", "-selection", "clipboard"])):
        if shutil.which(name) and (name == "xclip" and os.environ.get("DISPLAY") or name == "wl-copy" and os.environ.get("WAYLAND_DISPLAY")):
            try:
                subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True).communicate(text.encode(), timeout=3)
                return name
            except Exception: pass
    sys.stdout.write("\033]52;c;" + base64.b64encode(text.encode()).decode() + "\a"); sys.stdout.flush()
    return "OSC52"

def pos_label(top, view, total):
    """Lines on screen out of all of them, 'TOP'/'END' at the edges: '1-22/200 TOP', '179-200/200 END'."""
    if total <= view: return f"all {total}"
    return f"{top + 1}-{min(top + view, total)}/{total}" + (" TOP" if top == 0 else " END" if top + view >= total else "")

KEYS_LIST = " j/k move  g/G first/last  enter open  c copy  q quit "
KEYS_TICKET = " j/k scroll  space/b page  g/G top/end  o/O expand  n/p ticket  c copy  f Q&A  esc back  q quit "

def ui(scr, con, get_sources):
    curses.curs_set(0); curses.use_default_colors()
    for i in range(1, 7): curses.init_pair(i, i, -1)
    curses.init_pair(7, curses.COLOR_BLACK, curses.COLOR_CYAN)
    grey = 240 if curses.COLORS >= 256 else curses.COLOR_BLACK  # selected row: soft grey, not a white block
    curses.init_pair(8, -1, grey); curses.init_pair(9, curses.COLOR_GREEN, grey)
    scr.timeout(2000)
    feat = None; sel = ltop = top = maxtop = view = 0; qa = False; follow = True; msg = ""
    opened = {}      # ticket (fid) -> event lines the user expanded with o
    everything = set()  # tickets (fid) shown with every body expanded (O)
    tl = tlkey = None
    fs = features(con); dirty = True
    while True:
        if sync(con, get_sources()): fs = features(con); dirty = True
        if dirty:  # redraw only when a key, a resize or a new event changed something; an idle tick costs one stat per log
            dirty = False; h, w = scr.getmaxyx(); scr.erase()
            if not fs: scr.addstr(0, 0, "no events yet: no repo has logged (run team-log in a repo, or: team-tui --add <repo>)   (q quit)")
            else:
                sel = max(0, min(sel, len(fs) - 1)); lw = min(max(48, w // 3), w - 20) if feat else w
                rows = h - 2 if feat else h - 3  # list view keeps its last row for the ticket's request text
                if sel < ltop: ltop = sel  # keep the selected ticket on screen
                elif sel >= ltop + rows: ltop = sel - rows + 1
                ltop = max(0, min(ltop, len(fs) - rows))
                scr.addstr(0, 0, " Tickets / features ".ljust(lw)[:lw], curses.color_pair(7))
                for i, f in enumerate(fs[ltop: ltop + rows]):
                    running = status(f) == "running"
                    attr = curses.color_pair(9 if running else 8) if ltop + i == sel else (curses.color_pair(2) if running else 0)
                    scr.addstr(i + 1, 0, feature_line(f, lw).ljust(lw)[: lw - 1], attr)
                if feat:
                    cur = fid(fs[sel]); body_w = w - lw - 2
                    key = (cur, body_w, qa, frozenset(opened.get(cur, ())), cur in everything)
                    if key != tlkey: tl = Timeline(cur, body_w, qa, key[3], key[4]); tlkey = key
                    lines = tl.update(con)
                    view = h - 2; maxtop = max(0, len(lines) - view)
                    top = maxtop if follow else max(0, min(top, maxtop))
                    scr.addstr(0, lw + 1, f" {ticket_label(fs[sel])}  ({fs[sel]['repo']}){'  [Q&A only]' if qa else ''} ".ljust(body_w)[:body_w], curses.color_pair(7))
                    for i, (t, c) in enumerate(lines[top: top + view]):
                        scr.addstr(i + 1, lw + 1, t[:body_w], curses.color_pair(c) if c else 0)
                    status_line = f" {pos_label(top, view, len(lines))} |" + (f" {msg} |" if msg else "") + KEYS_TICKET
                else:
                    scr.addstr(h - 2, 0, (fs[sel]["request"] or "").replace("\n", " ")[: w - 1], curses.A_DIM)
                    status_line = (f" {msg} |" if msg else "") + KEYS_LIST
                scr.addstr(h - 1, 0, status_line[: w - 1], curses.A_DIM)  # position and message first: a narrow terminal cuts the key list, not them
        k = scr.getch()
        if k == -1: continue  # idle tick: only the sync above
        dirty = True
        if k == ord("q") or (k == 27 and not feat): return
        msg = ""
        if k == 27 and feat: feat = None
        elif k == ord("c") and fs:
            txt = "\n".join(t for t, _ in timeline(con, fid(fs[sel]), 10**6, qa if feat else False))  # always the full text
            msg = f"copied {txt.count(chr(10)) + 1} lines via {copy_clip(txt)}"
        elif feat and k in SCROLL_KEYS: top, follow = scroll(k, top, follow, maxtop, max(1, view - 1))
        elif feat and k == ord("o"):  # expand the first collapsed body that is on screen
            hit = next((ev for idx, ev in tl.marks if top <= idx < top + view), None) if tl else None
            if hit: opened.setdefault(fid(fs[sel]), set()).add(hit); follow = False
            else: msg = "nothing collapsed on screen"
        elif feat and k == ord("O"): everything ^= {fid(fs[sel])}; follow = False
        elif feat and k in (ord("n"), ord("p")): sel += 1 if k == ord("n") else -1; top = 0; follow = True
        elif feat and k in (10, 13, curses.KEY_ENTER, curses.KEY_RIGHT, ord("l")): pass  # already open: do not jump to the end
        elif k in (ord("g"), curses.KEY_HOME): sel = 0
        elif k in (ord("G"), curses.KEY_END): sel = len(fs) - 1
        elif k in (ord("j"), curses.KEY_DOWN): sel += 1
        elif k in (ord("k"), curses.KEY_UP): sel -= 1
        elif k in (10, 13, curses.KEY_ENTER, curses.KEY_RIGHT, ord("l")): feat = True; follow = True
        elif k == curses.KEY_LEFT or k == ord("h"): feat = None
        elif k == ord("f"): qa = not qa

def query(con, sql):
    """Read-only: a second connection opened mode=ro, so nothing typed here can change the index."""
    ro = sqlite3.connect(f"file:{db_path()}?mode=ro", uri=True)
    cur = ro.execute(sql)
    print("\t".join(c[0] for c in cur.description))
    for row in cur: print("\t".join("" if v is None else str(v).replace("\n", " ") for v in row))

if __name__ == "__main__":
    srcs = make_sources(); con = open_db(db_path()); a = sys.argv[1:]
    if a[:1] == ["--add"]:
        if len(a) < 2: sys.exit("usage: team-tui --add PATH")
        print("registered", register(a[1])); sys.exit(0)
    sync(con, srcs())
    if a[:1] == ["--dump"]: dump(con, a[1] if len(a) > 1 else None)
    elif a[:1] == ["--query"]:
        if len(a) < 2: sys.exit("usage: team-tui --query SQL")
        query(con, a[1])
    else:
        try: curses.wrapper(ui, con, srcs)
        except KeyboardInterrupt: pass  # Ctrl+C quits like q; wrapper has already restored the terminal
