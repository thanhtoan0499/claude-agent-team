{
  "description": "Log everything the team does without relying on the LLM: subagent lifecycle + full final reports + tool calls/errors, and (while a feature is active) the master's briefs, its questions to the user, and the user's answers",
  "hooks": {
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/team-hook", "timeout": 10 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/team-hook", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/team-hook", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Agent|Task|SendMessage|AskUserQuestion",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/team-hook", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/team-hook", "timeout": 10 } ] }
    ],
    "PostToolUseFailure": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/team-hook", "timeout": 10 } ] }
    ]
  }
}
